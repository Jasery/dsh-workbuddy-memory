{
  "name": "dsh-workbuddy-memory",
  "version": "0.1.3",
  "type": "module",
  "description": "Read and write WorkBuddy memory files from DSH: one set of Markdown files, two clients.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workbuddy",
    "memory"
  ],
  "license": "MIT",
  "author": "Jasery <jaserydev@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jasery/dsh-workbuddy-memory.git"
  },
  "homepage": "https://github.com/Jasery/dsh-workbuddy-memory#readme",
  "bugs": {
    "url": "https://github.com/Jasery/dsh-workbuddy-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\""
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  }
}


